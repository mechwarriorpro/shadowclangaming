{
    "stages": [
        {
            "type": "veil:blit",
            "shader": "destroying-minecraft:bloom/mipmaptree",
            "in": "destroying-minecraft:bloom/bloom_start",
            "out": "destroying-minecraft:bloom/mipmaptree"
        },
        {
            "type": "veil:blit",
            "shader": "destroying-minecraft:bloom/blur/horizontal",
            "in": "destroying-minecraft:bloom/mipmaptree",
